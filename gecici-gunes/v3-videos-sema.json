{
 "summary": "Create Video",
 "description": "Creates an avatar video: a HeyGen avatar or an image speaks your script or audio with lip-sync. Choose Avatar III, IV or V with `engine` (Avatar IV by default). To generate a whole scene from a prompt instead, use POST /v3/models/videos.",
 "tags": [
  "Videos"
 ],
 "security": [
  {
   "ApiKeyAuth": []
  },
  {
   "BearerAuth": []
  }
 ],
